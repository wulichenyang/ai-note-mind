# NoteMind Agent Service 配置模板（复制为 .env 使用）
# 线上部署时在 Vercel 面板配置同名环境变量

# 运行环境
APP_ENV=development

# 跨服务认证：web BFF 调用 agent 时携带的内部 token（本地随意，线上生成强随机值）
SERVICE_TOKEN=dev-local-agent-token

# ============ SiliconFlow（向量化 + 图片视觉，免费模型）============
# 注册拿 key：https://cloud.siliconflow.cn/account/ak
# 免费模型清单：https://siliconflow.cn/pricing
# embedding 用免费 BAAI/bge-m3（1024 维，与 DB vector(1024) 对齐，永久免费）
SILICONFLOW_API_KEY=sk-your-siliconflow-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
# 免费视觉模型：解析上传的图片（描述 + 转录图中文字）
VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct

# 对话生成兜底（正常走 web 端 BYOK，用户在设置页配自己的 DeepSeek Key）
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# 数据库（与 web 共用 Neon）
DATABASE_URL=postgresql://...
