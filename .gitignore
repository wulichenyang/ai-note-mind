# Monorepo 根目录忽略规则
# web/ 与 agent/ 各自的 .gitignore 处理子项目内部产物

# OS
.DS_Store
*.pem

# 编辑器
.idea/
.vscode/

# 调试日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Python (agent/)
__pycache__/
*.py[cod]
.venv/
venv/
.python-version
uv.lock

# 部署脚本用到的本地缓存（Vercel CLI 的配置/缓存、npm 缓存）
# 之所以关在仓库内：CLI 默认写 ~/Library/Application Support/com.vercel.cli，
# 在受限沙箱环境里会 EPERM 失败
.vercel-home/
.npm-cache/

# Vercel 本地关联信息（由 vercel link 生成，含 projectId，不入库）
.vercel/
