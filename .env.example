# ============ 数据库 ============
# Neon PostgreSQL 连接串（https://neon.tech 免费注册创建项目后复制）
# 格式: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# 本地开发用这个（.env.local），线上在 Vercel 里单独配置同一份
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# ============ 认证 Auth.js ============
# 会话加密密钥，本地用 `npx auth secret` 生成，线上必须重新生成一份
AUTH_SECRET="replace-with-a-random-secret"
# Google OAuth 凭据（https://console.cloud.google.com 创建 OAuth 客户端）
# 未配置前邮箱密码注册/登录依然可用
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ============ AI（DeepSeek，BYOK 方案）============
# 安全说明：公网部署后，为了让每个用户花自己的 AI 额度，不配置全局 Key。
# 用户登录后在 /settings 页面填写自己的 DeepSeek API Key，
# 服务端用 ENCRYPTION_KEY（AES-256-GCM）加密后存库，前端永远看不到明文。
# 未配置 Key 的用户使用 AI 功能会收到"请先在设置页配置"的提示。
# DeepSeek Key 获取：https://platform.deepseek.com（新用户有免费额度）
AI_BASE_URL="https://api.deepseek.com"
# OpenAI 兼容接口地址；想切回 OpenAI 改成 https://api.openai.com/v1 即可
# deepseek-chat = DeepSeek-V3；deepseek-reasoner = DeepSeek-R1（推理型）
# 用户可在设置页选择自己的模型，未选时用下面的默认值
AI_MODEL="deepseek-chat"

# 用户 AI Key 的加密主密钥（必须 64 位 hex = 32 字节）
# 本地用 `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"` 生成
# 线上部署必须在 Vercel 重新生成一份，且绝不提交/泄露
ENCRYPTION_KEY="replace-with-64-hex-chars"
